APP_NAME="Kasir Ende - Hari 7"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000


APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file


LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug


# Data katalog Hari 7 berasal dari array, belum memakai database.
# Koneksi ini baru dipakai jika menjalankan query/migration pada Hari 8.
DB_CONNECTION=sqlite
# Biarkan DB_DATABASE tidak diset agar Laravel memakai database/database.sqlite.


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


CACHE_STORE=file
CACHE_PREFIX=kasir_h7_
QUEUE_CONNECTION=sync


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local


MAIL_MAILER=log
MAIL_FROM_ADDRESS=kelas@example.test
MAIL_FROM_NAME="${APP_NAME}"